# Firebase web app config — Project settings > General > Your apps > SDK setup
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FB_PROJECT_ID=your-project
VITE_FB_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=

# Set to true to run against the local Firebase emulators instead
VITE_USE_EMULATORS=false
