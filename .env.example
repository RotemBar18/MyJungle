# Optional. src/firebase.config.js already points at the live project, so the app
# builds and runs with no .env at all — on Vercel, on Firebase Hosting, anywhere.
#
# Set these only to point a build at a DIFFERENT Firebase project:
# VITE_FB_API_KEY=
# VITE_FB_AUTH_DOMAIN=
# VITE_FB_PROJECT_ID=
# VITE_FB_STORAGE_BUCKET=
# VITE_FB_MESSAGING_SENDER_ID=
# VITE_FB_APP_ID=

# Develop against the local emulators instead of the real project:
#   firebase emulators:start
VITE_USE_EMULATORS=false
